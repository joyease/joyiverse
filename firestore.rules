rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 預設拒絕所有未明訂規則的存取
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. 檢查是否已登入
    function isSignedIn() {
      return request.auth != null;
    }

    // 2. 驗證目前登入的使用者是否為資料擁有者本人
    function isOwner(email) {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == email) ||
        (request.auth.uid != null && request.auth.uid == email)
      );
    }

    // 3. 欄位容量限制、型態與格式檢查 (安全防護且支援選填欄位)
    function isValidLog(data) {
      return data.userId is string 
        && data.userId.size() > 0 
        && data.userId.size() <= 150
        && data.type in ['旅行', '運動', '美食', '閱讀', '創作', '視聽', '寫字', '影片']
        && data.categoryGroup in ['outdoor', 'life']
        && data.note is string 
        && data.note.size() > 0 
        && data.note.size() <= 3000
        && data.isPublic is bool
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // 日誌與足跡資料庫 (Logs Collection)
    match /logs/{logId} {
      // 讀取：公開紀錄 (isPublic == true) 允許所有人瀏覽；私有紀錄僅限擁有者本人讀取
      allow get, list: if resource.data.isPublic == true 
                       || (isSignedIn() && (
                            (request.auth.token.email != null && request.auth.token.email == resource.data.userId) ||
                            (request.auth.uid != null && request.auth.uid == resource.data.userId)
                          ));

      // 新增：必須為登入的本人信箱，並通過嚴格的欄位大小與格式檢查
      allow create: if isOwner(request.resource.data.userId) 
                    && isValidLog(request.resource.data);

      // 修改：不可竄改擁有者 (Immutable Ownership) 與建立時間，且通過檢查
      allow update: if isOwner(resource.data.userId) 
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && isValidLog(request.resource.data);

      // 刪除：僅限資料擁有者本人
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
